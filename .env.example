PORT=3001
# All optional - defaults target the LiquiFact escrow on Stellar testnet.
# ESCROW_CONTRACT_ID=CDQCKR2YU6IVQ4GYPBMXBPZ4FGFQB5H25AI7ZSETHS2CZ5ZRCWQDSO6P
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# FRONTEND_URL=https://liquifact-frontend.vercel.app
# CORS_ALLOWED_ORIGINS=*
# PUBLIC_API_BASE_URL=https://liquifact-backend.vercel.app
# API keys for mutating routes: comma-separated id:role:sha256hex entries
# (roles: sme, investor, admin). Generate one with: npm run apikey:new -- --role sme
# API_KEYS=ak_1a2b3c4d:sme:<sha256hex>
# Dev-only fallback key (accepted as admin when API_KEYS is empty; never in production)
# DEV_API_KEY=local-dev-key
