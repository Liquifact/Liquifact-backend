# Port the server listens on (integer 1-65535, default: 3001)
PORT=3001

# Stellar network to connect to: testnet | mainnet (or public) | futurenet | custom (default: testnet)
# Presets:
#   - testnet:
#       Passphrase: "Test SDF Network ; September 2015"
#       RPC: https://soroban-testnet.stellar.org
#       Explorer: https://stellar.expert/explorer/testnet
#   - mainnet / public:
#       Passphrase: "Public Global Stellar Network ; September 2015"
#       RPC: (no default - SOROBAN_RPC_URL must be provided)
#       Explorer: https://stellar.expert/explorer/public
#   - futurenet:
#       Passphrase: "Test SDF Future Network ; October 2022"
#       RPC: https://rpc-futurenet.stellar.org
#       Explorer: https://stellar.expert/explorer/futurenet
#   - custom:
#       All values must be explicitly provided (SOROBAN_RPC_URL, STELLAR_NETWORK_PASSPHRASE, STELLAR_EXPLORER_URL)
STELLAR_NETWORK=testnet

# Soroban RPC endpoint (required for mainnet and custom, must be https:// or http://localhost)
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase (optional for presets, must match preset passphrase if provided)
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar explorer base URL (optional for presets, required for custom)
# STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# Soroban escrow contract address (must be a valid contract address starting with 'C')
# ESCROW_CONTRACT_ID=CDQCKR2YU6IVQ4GYPBMXBPZ4FGFQB5H25AI7ZSETHS2CZ5ZRCWQDSO6P

# Frontend application URL (absolute URL)
# FRONTEND_URL=https://liquifact-frontend.vercel.app

# Public API base URL for docs and OpenAPI spec (absolute URL)
# PUBLIC_API_BASE_URL=https://liquifact-backend.vercel.app

# Allowed CORS origins (comma-separated list of origins or '*')
# In NODE_ENV=production, '*' is disallowed unless ALLOW_ANY_ORIGIN=true
# CORS_ALLOWED_ORIGINS=*

# Set to 'true' to permit CORS_ALLOWED_ORIGINS='*' in production
# ALLOW_ANY_ORIGIN=false

# Node environment (development | test | production)
# NODE_ENV=development

# Audit log (hash-chained, in memory). The admin token guards GET /api/audit and /api/audit/verify;
# when it is unset those routes answer 503.
# ADMIN_API_TOKEN=change-me
# AUDIT_MAX_ENTRIES=10000
