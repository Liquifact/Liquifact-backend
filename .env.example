# Port the server listens on (integer 1-65535, default: 3001)
PORT=3001

# Graceful shutdown timeout in milliseconds when SIGTERM/SIGINT is received (positive integer, default: 10000)
# SHUTDOWN_TIMEOUT_MS=10000

# Stellar network to connect to: testnet | mainnet (or public) | futurenet | custom (default: testnet)
# Presets:
#   - testnet:
#       Passphrase: "Test SDF Network ; September 2015"
#       RPC: https://soroban-testnet.stellar.org
#       Explorer: https://stellar.expert/explorer/testnet
#   - mainnet / public:
#       Passphrase: "Public Global Stellar Network ; September 2015"
#       RPC: (no default - SOROBAN_RPC_URL must be provided)
#       Explorer: https://stellar.expert/explorer/public
#   - futurenet:
#       Passphrase: "Test SDF Future Network ; October 2022"
#       RPC: https://rpc-futurenet.stellar.org
#       Explorer: https://stellar.expert/explorer/futurenet
#   - custom:
#       All values must be explicitly provided (SOROBAN_RPC_URL, STELLAR_NETWORK_PASSPHRASE, STELLAR_EXPLORER_URL)
STELLAR_NETWORK=testnet

# Soroban RPC endpoint (required for mainnet and custom, must be https:// or http://localhost)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase (optional for presets, must match preset passphrase if provided)
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar explorer base URL (optional for presets, required for custom)
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# Soroban escrow contract address (must be a valid contract address starting with 'C')
ESCROW_CONTRACT_ID=CDQCKR2YU6IVQ4GYPBMXBPZ4FGFQB5H25AI7ZSETHS2CZ5ZRCWQDSO6P

# Frontend application URL (absolute URL)
FRONTEND_URL=https://liquifact-frontend.vercel.app

# Public API base URL for docs and OpenAPI spec (absolute URL)
PUBLIC_API_BASE_URL=https://liquifact-backend.vercel.app

# Allowed CORS origins (comma-separated list of origins or '*')
# In NODE_ENV=production, '*' is disallowed unless ALLOW_ANY_ORIGIN=true
CORS_ALLOWED_ORIGINS=*

# Set to 'true' to permit CORS_ALLOWED_ORIGINS='*' in production
ALLOW_ANY_ORIGIN=false

# Node environment (development | test | production)
NODE_ENV=development

# Admin API token (guards audit and admin routes)
ADMIN_API_TOKEN=change-me

# Audit log max entries (hash-chained, in memory)
AUDIT_MAX_ENTRIES=10000

# Cron secret for indexer scheduled runs
CRON_SECRET=change-me

# ESCROW_CONTRACT_ID must be a valid contract address starting with 'C'
# ESCROW_CONTRACT_ID=CDQCKR2YU6IVQ4GYPBMXBPZ4FGFQB5H25AI7ZSETHS2CZ5ZRCWQDSO6P

# Frontend application URL (absolute URL)
FRONTEND_URL=https://liquifact-frontend.vercel.app

# Protocol fee in basis points (non-negative integer, default 0)
# PROTOCOL_FEE_BPS=0

# Source account used to build read-only Soroban simulations (never signs or submits)
SIMULATION_SOURCE_ACCOUNT=GA7TXEBMEPQCLHIYCWDN7RKAO5IMRD2UV7O7TZXMEW6VZUMEXNR4XBB5

# When 'true', POST /api/invoices requires a verified smeId and takes sme/smeAddress from the SME record
REQUIRE_SME_VERIFICATION=false

# Idempotency-Required flag for POST /api/invoices and /api/invoices/:id/fund
IDEMPOTENCY_REQUIRED=false

# Idempotency TTL in seconds (how long to keep idempotency entries)
IDEMPOTENCY_TTL_SECONDS=86400

# Idempotency max entries to keep in memory
IDEMPOTENCY_MAX_ENTRIES=10000

# API keys for mutating routes: comma-separated id:role:sha256hex entries
# (roles: sme, investor, admin). Generate one with: npm run apikey:new -- --role sme
API_KEYS=ak_1a2b3c4d:sme:<sha256hex>

# Dev-only fallback key (accepted as admin when API_KEYS is empty; never in production)
DEV_API_KEY=local-dev-key

# Readiness probe (/ready): per-check timeout, maximum accepted ledger age and
# how long a probe result is reused before the RPC is called again.
READY_CHECK_TIMEOUT_MS=2000

READY_MAX_LEDGER_AGE_SECONDS=60

READY_CACHE_SECONDS=10

# Indexer start ledger (first ledger to query from)
INDEXER_START_LEDGER=0

# Maximum document bytes allowed
MAX_DOCUMENT_BYTES=10485760

# Transaction wait (ms) for ?wait=true, capped to stay within Vercel function limits
TX_WAIT_MS=20000

# Protocol fee in basis points (non-negative integer, default 0)
PROTOCOL_FEE_BPS=0

# When 'true', POST /api/invoices requires a verified smeId and takes sme/smeAddress from the SME record
REQUIRE_SME_VERIFICATION=false

# Soroban contract ID (alternative to ESCROW_CONTRACT_ID)
SOROBAN_CONTRACT_ID=CDQCKR2YU6IVQ4GYPBMXBPZ4FGFQB5H25AI7ZSETHS2CZ5ZRCWQDSO6P

# Soroban RPC URL (required for mainnet and custom)
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar explorer URL
# STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
