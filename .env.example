# Invoice tenor window (calendar days from today UTC).
# MIN_TENOR_DAYS: dueDate must be at least this many days in the future (default 1 = tomorrow earliest).
# MAX_TENOR_DAYS: dueDate must be at most this many days out (default 1825 = ~5 years, matching the
#   deployed escrow contract's maturity_max_horizon of 157 680 000 s; error 167 MaturityExceedsMaxHorizon).
# MIN_TENOR_DAYS=1
# MAX_TENOR_DAYS=1825
